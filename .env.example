# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/bhi_attendance?retryWrites=true
# At least 32 random characters. Also keys PIN uniqueness: changing it later means existing PINs
# can't be checked for clashes until each student gets a new PIN.
SESSION_SECRET=

# Optional (defaults shown)
APP_TIMEZONE=America/New_York
TIME_ENTRY_WINDOW_MINUTES=15
MIN_CLASS_MINUTES=5
MAX_CLASS_MINUTES=720
# Teachers can change a row for this many days after its class day; then only admins.
EDIT_WINDOW_DAYS=7
# Attendance colours: green at or above GOOD, orange at or above ATTENTION, red below.
ATTENDANCE_GOOD_PERCENT=90
ATTENDANCE_ATTENTION_PERCENT=75
