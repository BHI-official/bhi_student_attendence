# MongoDB connection string, with the database name after the host.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/bhi_attendance?retryWrites=true
# At least 32 random characters. Changing it signs everyone out and invalidates PIN uniqueness keys.
SESSION_SECRET=
# Optional
APP_TIMEZONE=America/New_York
MIN_CLASS_MINUTES=5
MAX_CLASS_MINUTES=720
ATTENDANCE_GOOD_PERCENT=90
ATTENDANCE_ATTENTION_PERCENT=75
# Class schedule shown to students as a guide when they write their times
SCHEDULE_START=9:00 AM
SCHEDULE_LUNCH_OUT=12:00 PM
SCHEDULE_LUNCH_IN=12:30 PM
SCHEDULE_END=4:00 PM
